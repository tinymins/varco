import { Button, CheckBox, LineEdit, AboutSlint, ScrollView, Switch } from "std-widgets.slint";
import "../assets/fonts/NotoSansSC-Subset.otf";

export struct MemberRow { hostname: string, ip: string, is-self: bool }

component Row {
    in property <string> label;
    in property <string> value;
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.label; width: 44px; color: #666; }
        Text { text: root.value; horizontal-stretch: 1; overflow: elide; }
    }
}

export component App inherits Window {
    title: "varco";
    icon: @image-url("../assets/icon/varco.png");
    preferred-width: 440px;
    min-width: 340px;
    preferred-height: 640px;
    min-height: 300px;
    default-font-family: "Noto Sans SC";
    default-font-size: 14px;
    background: #fafafa;

    // Flipping this repaints the whole window. Slint otherwise redraws only what it
    // knows has changed, which is nothing when the OS is the one that lost the pixels.
    in-out property <bool> repaint-phase;
    Rectangle {
        background: root.repaint-phase ? #fafafb : #fafafa;
    }

    // Which screen: false is the code entry, true is the joined network.
    in property <bool> joined;
    in property <bool> busy;
    in property <string> status-text;
    in property <color> status-color: #1a7f37;
    in property <string> error-text;
    in property <string> network;
    in property <string> ip;
    in property <string> cidr;
    in property <string> latency;
    in property <string> upload;
    in property <string> download;
    in property <[MemberRow]> members;
    in-out property <string> code;
    // Fingerprint of the key this Code would allow to log in.
    in property <string> code-grant;

    // Join without a virtual NIC. Not remembered: it is a remedy, not a preference.
    in-out property <bool> ssh-only;
    // SSH server. Off on every start: only the key is remembered.
    in-out property <bool> ssh-on;
    in-out property <string> ssh-pubkey;
    in property <bool> ssh-key-valid;
    in property <string> ssh-key-error;
    in property <string> ssh-status;
    in property <color> ssh-status-color: #1a7f37;
    in property <string> ssh-command;
    in property <string> ssh-fingerprint;
    // Set when the key came with the package: whoever runs it should see who can log in.
    in property <string> ssh-configured-key;
    in property <bool> ssh-admin;

    // Page for building a Code that also grants SSH.
    in-out property <bool> show-compose;
    in-out property <string> compose-code;
    in-out property <string> compose-key;
    in property <string> compose-result;
    in property <string> compose-info;
    in property <string> compose-error;

    callback confirm(string);
    callback code-edited(string);
    callback compose-opened();
    callback compose-edited();
    callback disconnect();
    callback ssh-toggled(bool);
    callback ssh-pubkey-edited(string);

    property <bool> show-about;
    in-out property <bool> copied;

    copied-timer := Timer {
        interval: 1500ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }

    // Slint has no clipboard API; this hidden input provides one.
    clipboard := TextInput {
        visible: false;
        width: 0; height: 0;
        text: root.ip;
    }

    compose-clipboard := TextInput {
        visible: false;
        width: 0; height: 0;
        text: root.compose-result;
    }

    ssh-clipboard := TextInput {
        visible: false;
        width: 0; height: 0;
        text: root.ssh-command;
    }

    if !root.joined && !root.show-about && !root.show-compose: VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: center;
        Text { text: "加入组网"; font-size: 20px; font-weight: 600; }
        Text { text: "请粘贴收到的 Code"; color: #666; }
        code-input := LineEdit {
            placeholder-text: "varco://…";
            enabled: !root.busy;
            text <=> root.code;
            edited(value) => { root.code-edited(value); }
            accepted => { root.confirm(root.code); }
        }
        if root.code-grant != "": Text {
            text: "⚠ 这个 Code 会允许持有私钥的人远程控制这台电脑（公钥 " + root.code-grant + "）";
            color: #b42318;
            font-weight: 600;
            wrap: word-wrap;
        }
        CheckBox {
            text: "仅 SSH，不创建网卡";
            enabled: !root.busy;
            checked <=> root.ssh-only;
        }
        Button {
            text: root.busy ? "连接中…" : "确认";
            primary: true;
            enabled: !root.busy && root.code != "";
            clicked => { root.confirm(root.code); }
        }
        if root.error-text != "": Text {
            text: "✗ " + root.error-text;
            color: #b42318;
            wrap: word-wrap;
        }
        if !root.busy: TouchArea {
            height: 24px;
            clicked => {
                root.show-compose = true;
                root.compose-opened();
            }
            Text { text: "生成远程协助 Code →"; color: #888; font-size: 12px; }
        }
    }

    if root.show-compose && !root.show-about: VerticalLayout {
        padding: 24px;
        spacing: 10px;
        alignment: center;
        Text { text: "生成远程协助 Code"; font-size: 20px; font-weight: 600; }
        Text { text: "服务端 Code"; color: #666; }
        LineEdit {
            placeholder-text: "varco://…";
            text <=> root.compose-code;
            edited => { root.compose-edited(); }
        }
        Text { text: "你的 SSH 公钥"; color: #666; }
        LineEdit {
            placeholder-text: "ssh-ed25519 AAAA…";
            text <=> root.compose-key;
            edited => { root.compose-edited(); }
        }
        if root.compose-error != "": Text {
            text: "✗ " + root.compose-error;
            color: #b42318;
            wrap: word-wrap;
        }
        if root.compose-info != "": Text {
            text: root.compose-info;
            color: #666;
            font-size: 12px;
            wrap: word-wrap;
        }
        Button {
            text: root.copied ? "已复制" : "复制联合 Code";
            primary: true;
            enabled: root.compose-result != "";
            clicked => {
                compose-clipboard.select-all();
                compose-clipboard.copy();
                root.copied = true;
            }
        }
        Text {
            text: "发给对方后，对方点确认就会让你远程控制它。";
            color: #b54708;
            font-size: 12px;
            wrap: word-wrap;
        }
        Button { text: "返回"; clicked => { root.show-compose = false; } }
    }

    if root.joined && !root.show-about && !root.show-compose: VerticalLayout {
        padding: 20px;
        // Leaves the top right corner to the About link, however long the status gets.
        padding-top: 30px;
        spacing: 8px;
        Text { text: "● " + root.status-text; color: root.status-color; font-size: 16px; font-weight: 600; wrap: word-wrap; }
        if root.ssh-only: Text { text: "仅 SSH 模式：这台电脑不能访问其他成员"; color: #666; font-size: 12px; wrap: word-wrap; }
        ScrollView {
            vertical-stretch: 1;
            min-height: 120px;
            VerticalLayout {
                alignment: start;
                spacing: 8px;
                padding-right: 12px;
                Row { label: "网络"; value: root.network; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "本机IP"; width: 44px; color: #666; vertical-alignment: center; }
                    Text { text: root.ip; font-weight: 600; vertical-alignment: center; }
                    Button {
                        text: root.copied ? "已复制" : "复制";
                        clicked => {
                            clipboard.select-all();
                            clipboard.copy();
                            root.copied = true;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Row { label: "网段"; value: root.cidr; }
                Row { label: "延迟"; value: root.latency; }
                Row { label: "上行"; value: root.upload; }
                Row { label: "下行"; value: root.download; }
                Text { text: "在线成员"; color: #666; }
                for member in root.members: Row {
                    label: member.is-self ? "本机" : "";
                    value: member.ip + "   " + member.hostname;
                }

                Rectangle { height: 1px; background: #e2e2e2; }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "SSH 服务器"; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    Switch {
                        checked <=> root.ssh-on;
                        // Turning off is always possible.
                        enabled: root.ssh-on || root.ssh-key-valid;
                        toggled => { root.ssh-toggled(self.checked); }
                    }
                }
                if !root.ssh-on: LineEdit {
                    placeholder-text: "粘贴公钥，例如 ssh-ed25519 AAAA…";
                    text <=> root.ssh-pubkey;
                    edited(value) => { root.ssh-pubkey-edited(value); }
                }
                if !root.ssh-on && root.ssh-key-error != "": Text {
                    text: root.ssh-key-error;
                    color: #b42318;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if !root.ssh-on: Text {
                    text: root.ssh-admin
                        ? "开启后，持有对应私钥的人能以管理员权限完全控制这台电脑。"
                        : "开启后，持有对应私钥的人能以当前用户身份操作这台电脑。";
                    color: #666;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.ssh-on: Text {
                    text: root.ssh-status;
                    color: root.ssh-status-color;
                    wrap: word-wrap;
                }
                if root.ssh-on && root.ssh-command != "": HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.ssh-command; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Button {
                        text: "复制";
                        clicked => {
                            ssh-clipboard.select-all();
                            ssh-clipboard.copy();
                        }
                    }
                }
                if root.ssh-on && root.ssh-configured-key != "": Text {
                    text: "SSH 由启动配置自动开启，可登录的公钥 " + root.ssh-configured-key;
                    color: #b54708;
                    font-size: 12px;
                    // A fingerprint is one long word: word-wrap would widen the scroll area to fit it.
                    wrap: char-wrap;
                }
                if root.ssh-on && root.ssh-fingerprint != "": Text {
                    text: "主机指纹 " + root.ssh-fingerprint;
                    color: #666;
                    font-size: 11px;
                    wrap: char-wrap;
                }
                if root.ssh-on && root.ssh-admin: Text {
                    text: "远程 shell 具有管理员权限。不用时请关闭。";
                    color: #b54708;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
        Button { text: "断开"; clicked => { root.disconnect(); } }
    }

    if root.show-about: VerticalLayout {
        padding: 20px;
        spacing: 12px;
        alignment: center;
        AboutSlint { }
        Button { text: "返回"; clicked => { root.show-about = false; } }
    }

    if !root.show-about: TouchArea {
        x: root.width - 52px;
        y: 6px;
        width: 44px;
        height: 24px;
        clicked => { root.show-about = true; }
        Text { text: "关于"; color: #888; font-size: 12px; }
    }
}
