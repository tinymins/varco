[Unit]
Description=varco relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/varco server -c /etc/varco/config.toml
Restart=always
RestartSec=2
# useradd --system varco; install -d -o varco -m 700 /etc/varco
User=varco
# The server has no NIC and needs no privileges. To listen below port 1024, uncomment:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
# The server key is created here on first start.
ReadWritePaths=/etc/varco
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
