[Unit]
Description=varco relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/varco server --data-dir /var/lib/varco
Restart=always
RestartSec=2
# useradd --system --no-create-home --shell /usr/sbin/nologin varco
User=varco
# The server has no NIC and needs no privileges. To listen below port 1024, uncomment:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
# Creates /var/lib/varco, which holds the database and the server key.
StateDirectory=varco
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
